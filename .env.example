# Port na kojem sluša API server u lokalnom razvoju.
# Na Vercelu se ne koristi — tamo funkciju poziva platforma.
PORT=3001

# Token za /admin. PROMIJENI OVO prije bilo kakvog deploya.
# Ovo NIJE pravi auth sistem - samo sprječava da lista narudžbi bude javna.
ADMIN_TOKEN=lafamilia-dev-token-promijeni-me

# Postgres. Lokalno je to kontejner koji diže `npm run db:up`.
# Na Vercelu ide connection string iz Neona — OBAVEZNO onaj sa `-pooler` u
# hostu: serverless funkcija otvara novu vezu po instanci, a direktni endpoint
# potroši limit veza prije nego sajt primi ozbiljan promet.
DATABASE_URL=postgres://dev:dev@localhost:55432/dolcefamilia

# Vercel Blob — ovdje završavaju fotografije koje admin učita kroz formu.
# Bez ovoga (lokalni razvoj) slike idu na disk u data/uploads/.
# Vrijednost daje Vercel kad u projektu kreirate Blob store.
BLOB_READ_WRITE_TOKEN=

# Zona radnje. Određuje šta je "danas" u admin pregledu i od kad važi akcija.
# Ne nasljeđuje se od servera — na Vercelu je to UTC.
SHOP_TIMEZONE=Europe/Sarajevo
